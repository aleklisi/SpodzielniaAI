# Single origin for UI + API, plus the IdP on auth.<domain>.
#   SITE_DOMAIN   spoldzielnia.localhost (dev) | real domain (prod)
#   CADDY_TLS     "internal" (dev: Caddy's local CA) | ACME e-mail address (prod: Let's Encrypt)
#   KC_ADMIN_ALLOW  remote IPs/CIDRs allowed to reach the Keycloak admin console
{
	admin off
	# No `trusted_proxies`: Caddy is the outermost hop, so client-supplied X-Forwarded-* are
	# replaced with the real peer address.
}

# Container healthcheck only; bound to loopback inside the proxy container, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond "ok" 200
}

# Defaults (`?`: only where the upstream set none). The frontend and the API send their own,
# stricter headers (the frontend's CSP carries a per-request nonce, 6.1); Keycloak gets these.
(security_headers) {
	header {
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}
}

{$SITE_DOMAIN:spoldzielnia.localhost} {
	tls {$CADDY_TLS:internal}
	import security_headers
	encode zstd gzip

	# Largest upload accepted by the API (audio/video 200 MB, chunk 2.2) plus multipart overhead.
	# The API enforces the per-type limits while streaming.
	request_body {
		max_size 210MB
	}

	# Prometheus scrapes api:8000/metrics on the internal network; it is not public.
	handle /api/metrics {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Everything else is the Next.js UI (same origin: __Host- cookies, SameSite=Strict).
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}

auth.{$SITE_DOMAIN:spoldzielnia.localhost} {
	tls {$CADDY_TLS:internal}
	import security_headers

	@admin_denied {
		path /admin /admin/*
		not remote_ip {$KC_ADMIN_ALLOW:127.0.0.1/8}
	}
	respond @admin_denied "Forbidden" 403

	# Metrics/health live on the management port (9000), never exposed.
	reverse_proxy keycloak:8080
}
