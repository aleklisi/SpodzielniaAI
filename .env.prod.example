# Production server settings (6.8). Copy to `.env` on the server and fill in. Read by
# docker compose (compose.yaml + compose.prod.yaml) and the operations scripts; the app itself
# takes its settings from compose. Secrets are never here: `make secrets` writes ./secrets.
# Runbook: docs/ops/DISASTER_RECOVERY.md. Model settings: see .env.example (same variables).

# --- Required ---------------------------------------------------------------------------------
# Public domain: the UI and API on https://<SITE_DOMAIN>, Keycloak on https://auth.<SITE_DOMAIN>
# (DNS A/AAAA records for both, ports 80 and 443 reachable for Let's Encrypt).
SITE_DOMAIN=spoldzielnia.example.org
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.org
# Image prefix in the registry (publish.yml pushes ghcr.io/<owner>/spoldzielnia/<image>:vX.Y.Z).
# VERSION is not set here: `make deploy VERSION=vX.Y.Z` passes it.
REGISTRY=ghcr.io/example/spoldzielnia

# --- Keycloak -----------------------------------------------------------------------------------
# Remote addresses allowed to reach the Keycloak admin console on auth.<SITE_DOMAIN>/admin
# (Caddy `remote_ip` syntax). Default: nobody from outside; use an SSH tunnel.
# KC_ADMIN_ALLOW=127.0.0.1/8
# Mail for password resets and required actions (credentials: Keycloak console → Email).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=noreply@spoldzielnia.example.org

# --- Backups (make backup; nightly timer in the runbook) ---------------------------------------
# age recipients (public keys, one per line) of the data bundle, and of the secrets bundle
# (the KEK): give that one a key kept apart from the first. The private keys never live here.
BACKUP_DIR=/var/backups/spoldzielnia
BACKUP_RECIPIENTS=/etc/spoldzielnia/backup-recipients.txt
# BACKUP_SECRETS_RECIPIENTS=/etc/spoldzielnia/secrets-recipients.txt
# BACKUP_KEEP=14

# --- Models (Stage 10): none required; admins configure API providers in /admin/llm ------------
# An Ollama container on this server (GPU: GPU=1 make deploy ... adds compose.gpu.yaml):
# COMPOSE_PROFILES=ollama
# OLLAMA_MEM_LIMIT=16g
# LLM_ALLOW_CLOUD=false
# LLM_CLOUD_HOSTS=[]
# LLM_PRIVATE_DATA_ENDPOINTS=["http://llm:11434"]
