# Non-secret configuration for local runs. Copy to `.env`.
# Nested groups use `__`: SPOLDZIELNIA_<GROUP>__<FIELD>.
#
# Secrets are NOT configured here. In Docker they are files under /run/secrets named after the
# nested field path (e.g. /run/secrets/db__app_password), generated by `make secrets` (chunk 1.2a).
# For a bare `uv run` outside Docker you may export them as env vars, e.g.
#   SPOLDZIELNIA_DB__APP_PASSWORD, SPOLDZIELNIA_REDIS__PASSWORD,
#   SPOLDZIELNIA_OIDC__CLIENT_SECRET, SPOLDZIELNIA_SECURITY__SESSION_SECRET

SPOLDZIELNIA_ENVIRONMENT=dev
SPOLDZIELNIA_LOG_LEVEL=INFO
SPOLDZIELNIA_ROOT_PATH=/api
SPOLDZIELNIA_API_PORT=8000

SPOLDZIELNIA_DB__HOST=postgres
SPOLDZIELNIA_DB__PORT=5432
SPOLDZIELNIA_DB__NAME=spoldzielnia

SPOLDZIELNIA_REDIS__HOST=redis
SPOLDZIELNIA_REDIS__PORT=6379

SPOLDZIELNIA_OIDC__ISSUER=https://auth.spoldzielnia.localhost/realms/spoldzielnia
SPOLDZIELNIA_OIDC__CLIENT_ID=spoldzielnia-backend

SPOLDZIELNIA_QDRANT__URL=https://qdrant:6333
SPOLDZIELNIA_S3__ENDPOINT_URL=http://minio:9000
SPOLDZIELNIA_LLM__LOCAL_BASE_URL=http://llm:11434

SPOLDZIELNIA_SECURITY__ALLOWED_ORIGINS=["https://spoldzielnia.localhost"]

# --- docker compose variables (read by compose.yaml, not by the app) -------------------------
# Models (Stage 10): none is required. Admins configure providers in /admin/llm; a model server
# is optional: `--profile ollama` (Ollama container) or `--profile relay` with
# LLM_RELAY_TARGET=host:port (LM Studio etc. on another machine, e.g. over a VPN).
# LLM_RELAY_TARGET=10.8.0.2:1234
# Built-in engines are opt-in (`make models WHISPER=1 DOCLING_OCR=1 SIGLIP=1`, then the
# LLM_BUILTIN_* switches below); with them on, raise WORKER_MEDIA_MEM_LIMIT=4g and
# WORKER_CORE_MEM_LIMIT=3g (API-only defaults: 1g and 2560m).
# Local LLM models by the names the OpenAI-compatible server uses (empty = not available).
# LLM_CHAT_MODEL=
# LLM_VLM_MODEL=
# LLM_EMBED_MODEL=
# Speech-to-text model on the same endpoint (/v1/audio/transcriptions, e.g. a whisper server).
# Without one, worker-media's built-in faster-whisper can transcribe (`make models WHISPER=1`,
# then =true; default off, dev on). Recordings are cut into 10-minute WAV segments.
# LLM_TRANSCRIBE_MODEL=
# LLM_BUILTIN_TRANSCRIPTION=false
# Scanned PDF pages are read by the vision model routed for „Odczyt skanów (OCR)” (in .env mode:
# LLM_VLM_MODEL). Without one, Docling's built-in OCR can (`make models DOCLING_OCR=1`, then =true).
# LLM_BUILTIN_OCR=false
# The visual atlas's image embeddings: an embedding server for CLIP/SigLIP on the local endpoint
# (OpenAI-style /v1/embeddings with image data URIs, e.g. Infinity). Without one, worker-core's
# built-in SigLIP can (`make models SIGLIP=1`, then =true). Changing it rebuilds the atlas index.
# LLM_IMAGE_EMBED_MODEL=
# LLM_BUILTIN_IMAGE_EMBED=false
# The vector dimension is read from the embedding model itself (10.3): changing the model in
# /admin/llm builds a new version of the search index in the background and swaps it in.
# Stage 7 (admin console /admin/llm): what admins may choose from. JSON lists.
# Extra local OpenAI-compatible endpoints (origins), e.g. ["http://vllm:8000"].
# LLM_LOCAL_ENDPOINTS=[]
# Cloud APIs (https hosts) and whether RAG may use them at all. Before enabling, confirm that
# creators' consent covers sending canonical wiki content to a third party.
# LLM_ALLOW_CLOUD=false
# LLM_CLOUD_HOSTS=["api.openai.com"]
# Stage 10.1 (AGENTS.md rule 4): endpoints whose providers an admin may clear for private data
# (private notes, PII scrubbing, promotion drafts, photos, embeddings). Origins, JSON list.
# Unset = the local endpoints above. [] = none (private features stay off). A cloud API here,
# e.g. ["http://llm:11434","https://api.mistral.ai"], needs a data processing agreement.
# LLM_PRIVATE_DATA_ENDPOINTS=["http://llm:11434"]
